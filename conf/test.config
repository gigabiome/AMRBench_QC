/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running a minimal test
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Use as follows:
        nextflow run main.nf -profile test,<docker/singularity/conda> --outdir <OUTDIR>
----------------------------------------------------------------------------------
*/

params {
    // One sample of 1 M read pairs from the nf-core bacass test dataset
    input = "${projectDir}/assets/samplesheet_test.csv"
}

process {
    resourceLimits = [
        cpus: 4,
        memory: 8.GB,
        time: 2.h,
    ]
}
