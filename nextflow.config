/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    gigabiome/AMRBench_QC Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------
*/

params {
    // Input options
    input            = null

    // Tool options: extra command-line arguments passed straight to each tool
    fastp_args       = ''
    unicycler_args   = ''
    prokka_args      = ''

    // Output options
    outdir           = 'results'
    publish_dir_mode = 'copy'
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
    }
    // Apple Silicon: run the x86 containers under emulation
    arm {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g) --platform linux/amd64'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
    }
    conda {
        conda.enabled          = true
    }
    test { includeConfig 'conf/test.config' }
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
}

manifest {
    name            = 'gigabiome/AMRBench_QC'
    homePage        = 'https://github.com/gigabiome/AMRBench_QC'
    description     = 'Read QC, assembly and gene prediction for bacterial genomes'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '1.0.0dev'
}

// Load modules.config for per-module options
includeConfig 'conf/modules.config'
